# SmartWrite environment variables — copy to .env and fill in real values.
# .env is gitignored; never commit real secrets.

# --- App ---
DEBUG=true

# --- Database ---
# Local dev (async SQLite). Production overrides this with a Render Postgres URL
# using the asyncpg driver, e.g. postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./smartwrite.db

# --- Auth (used from milestone 2) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# --- AI engine (used from milestone 3) ---
GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.3-70b-versatile

# --- History encryption (used from milestone 4) ---
# IMPORTANT: must be a Fernet key, generated with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HISTORY_ENCRYPTION_KEY=replace-me
