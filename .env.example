# Copy this file to .env and fill in real values. Never commit .env.

# ---- App ----
DEBUG=false

# ---- Database ----
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./smartwrite.db
# Production (Render Postgres) — override via Render env vars:
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# ---- Groq AI ----
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Correction history encryption ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must be a 32-byte URL-safe base64 key — NOT a hex string.
HISTORY_ENCRYPTION_KEY=your-fernet-key-here
